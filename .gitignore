# Environment and secrets
.env
.env.local

# OAuth credentials and tokens — NEVER commit these
data/personal_gmail_credentials.json
data/personal_gmail_token.json
data/*_credentials.json
data/*_token.json
data/*_token.json.dead-*
data/*_credentials.json.dead-*
**/client_secret_*.json
**/*.credentials.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# Testing
.pytest_cache/

# IDE
.vscode/
.idea/

# OS
.DS_Store

# Data (keep structure, ignore generated content)
data/processed/*.md
*.db
*.db-shm
*.db-wal
data/*.zip

# Claude Code worktrees (per-session scratch, not source)
.claude/worktrees/

# Manual-input seed corpus (142MB of binary chart screenshots) — staging
# area on disk, not source. Drained into documents via /api/manual/ingest
# in Piece 2. See DECISIONS 2026-05-09 entry.
manual_entry/

# User-staged screenshot folders the bulk-import script reads from.
# Hundreds of binary PNGs; not source code.
manual_inputs/

# Manual-input chart uploads (user-generated runtime content, not source)
uploads/

# DB backups created during merges/migrations. The `*.db` rule above does not
# match these — the suffix comes after the extension (macro_positioning.db.pre-redrain).
# ~600MB across the .pre-* set; snapshots on disk, never source.
*.db.pre-merge-backup
*.db.backup
*.db.pre-*

# HTTP response cache (EDGAR filings etc) — 80MB of binary blobs, regenerable.
cache/

# N8N / runtime logs
*.log

# Training corpus — accumulating LLM call records for future fine-tuning.
# Sensitive; managed via separate sync, not git. Keep the directory marker.
training_corpus/*.jsonl
training_corpus/*.parquet
!training_corpus/.gitkeep

# Trained model artifacts — large binaries; separate strategy when these exist
src/macro_brain/models/*.bin
src/macro_brain/models/*.pt
src/macro_brain/models/*.safetensors
src/macro_brain/models/*.gguf

# Telegram session file — credentials artefact, never commit
data/telegram.session*
*.session-journal

# Incident artifacts (2026-08-04 DB deletion + recovery). Multi-hundred-MB
# rescued copies; the `*.db.pre-*` rule above does not catch these suffixes.
data/rescue/
data/recovery/
*.db.pid*
*.db.pre-guardtest-recovery

# Chart Lab intake — charts are data, not source
chart-inbox/

# Rendered brief HTML (scripts/build_brief.py output) — generated, 36MB
/briefs/

# Local .env copies kept while switching profiles — secrets, never commit
.env.bak*
.env.*.bak

# Design-folder preview thumbnail (WebP, regenerated by the editor)
DESIGN FOLDER*/.thumbnail
