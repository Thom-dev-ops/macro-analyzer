{
  "$schema_version": "1.0",
  "description": "Attribution taxonomy for the paper book: which sleeve a position belongs to, which class that sleeve rolls up into, and which macro regime the sleeve is an expression of. This is a REPORTING map, not a trading rule — it never gates a fill. Correlated-position caps come from config/correlation_buckets.json; this file exists so P&L can be read as 'the hard-asset book made money and the risk-on book didn't'.",

  "$resolution_rules": {
    "order": "sleeves are evaluated in declaration order; the first whose membership contains the ticker wins",
    "membership": "union of (a) the watchlist_tickers of the referenced `theme` in config/asset_themes.json, (b) the members of each referenced correlation `bucket`, and (c) the explicit `tickers` list here",
    "unmatched": "falls through to the sleeve `unclassified`, which is reported honestly rather than silently folded into another sleeve",
    "resolution_time": "read time, not entry time — re-classifying a ticker here corrects history instead of leaving old positions mis-bucketed"
  },

  "classes": {
    "hard_assets": {
      "label": "Hard assets",
      "note": "Real things and the equities that dig them up. The debasement / commodity-inflation expression."
    },
    "equities": { "label": "Equities", "note": "Listed equity risk, sliced by sector and theme." },
    "crypto": { "label": "Crypto", "note": "Digital assets and their listed proxies." },
    "rates_fx": { "label": "Rates & FX", "note": "Duration and dollar — the macro hedges." },
    "volatility": { "label": "Volatility", "note": "Explicit vol exposure." },
    "cash": { "label": "Cash", "note": "Dry powder held deliberately, not by accident." },
    "other": { "label": "Unclassified", "note": "Nothing has been mapped yet. A large number here is a to-do, not a category." }
  },

