<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.macro.paper-tick</string>

    <!-- Use the venv python DIRECTLY (not `uv run`): this interpreter has been
         granted Full Disk Access, so launchd can reach the repo under
         ~/Documents. Same pattern as com.macro.free-ingest. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/thom/Documents/Personal/Code Projects/Macro Analyzer/.venv/bin/python</string>
        <string>scripts/paper_trading_tick.py</string>
        <string>--execute</string>
        <string>--bootstrap</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/thom/Documents/Personal/Code Projects/Macro Analyzer</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/thom/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- 06:15 and 13:15 — a quarter-hour behind com.macro.free-ingest so the
         book always trades the freshest scoring pass rather than yesterday's. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key><integer>6</integer>
            <key>Minute</key><integer>15</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>13</integer>
            <key>Minute</key><integer>15</integer>
        </dict>
    </array>

    <!-- One-shot batch job: exits when done, so no KeepAlive. RunAtLoad is
         false on purpose — loading the job should not itself trade the book. -->
    <key>RunAtLoad</key>
    <false/>

    <!-- The tick prints its full decision set, so this log is the audit trail:
         every fill, every hold, and every name the mandate turned away. -->
    <key>StandardOutPath</key>
    <string>/Users/thom/Library/Logs/macro-paper-tick.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/thom/Library/Logs/macro-paper-tick.err.log</string>
</dict>
</plist>
