<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.macro.stock-unlocked-tick</string>

    <!-- Venv python directly (Full Disk Access), same as the other ticks. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/thom/Documents/Personal/Code Projects/Macro Analyzer/.venv/bin/python</string>
        <string>scripts/stock_unlocked_tracker_tick.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/thom/Documents/Personal/Code Projects/Macro Analyzer</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/thom/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Every two hours. Day trades on this channel resolve in hours, and
         the pass costs a handful of keyless candle requests per open call. -->
    <key>StartInterval</key>
    <integer>7200</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/thom/Library/Logs/macro-stock-unlocked-tick.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/thom/Library/Logs/macro-stock-unlocked-tick.err.log</string>
</dict>
</plist>
